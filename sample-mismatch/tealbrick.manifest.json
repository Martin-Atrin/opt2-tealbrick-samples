{
  "$schema": "https://spec.opt2.tealbrick.com/manifest.schema.json",
  "schema": "tealbrick.miniapp/2",
  "id": "sample-mismatch",
  "name": "Sample Mismatch",
  "summary": "Sample Mismatch serves a manifest that differs from its release record. QA fixture — dev channel only, never in the default catalog.",
  "description": "QA fixture: deliberately serves a manifest different from its release record.\n\nQA fixture — dev channel only, never in the default catalog. At run time the app appends \" (runtime)\" to `summary`, so its reported manifest digest differs from the release record and the bridge refuses it (`manifest_mismatch`).",
  "version": "0.2.0-dev.4",
  "sdkMajor": 1,
  "publisher": {
    "name": "Teal Brick opt2 samples"
  },
  "source": {
    "repo": "https://github.com/Tealbrick/opt2-tealbrick-samples",
    "license": "Apache-2.0"
  },
  "icon": {
    "svgPath": "M4 4h16v16H4z M8 8l8 8 M16 8l-8 8",
    "viewBox": "0 0 24 24"
  },
  "discovery": {
    "category": "developer",
    "intents": [
      "check a manifest mismatch"
    ],
    "keywords": [
      "fixture",
      "qa",
      "mismatch"
    ]
  },
  "runtime": {
    "build": {
      "context": "sample-mismatch",
      "dockerfile": "sample-mismatch/Dockerfile"
    },
    "port": 8080,
    "healthPath": "/tb/v1/health",
    "resources": {
      "cpu": 0.25,
      "memoryMb": 256
    },
    "volumes": [
      {
        "id": "data",
        "mountPath": "/data",
        "sizeGb": 1,
        "purpose": "data"
      },
      {
        "id": "backup",
        "mountPath": "/backup",
        "sizeGb": 2,
        "purpose": "backup"
      }
    ]
  },
  "operations": [
    {
      "id": "mismatch_ping",
      "title": "Ping",
      "description": "Test fixture: answer pong (the bridge should never let an agent reach it).",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pong"
        ],
        "properties": {
          "pong": {
            "type": "boolean"
          }
        }
      },
      "crud": [
        "read"
      ],
      "effect": "read",
      "idempotency": "none",
      "receipt": false,
      "audience": "agent"
    }
  ],
  "skills": [
    {
      "id": "use-sample-mismatch",
      "title": "How to use Sample Mismatch",
      "file": "skills/use-sample-mismatch/SKILL.md"
    }
  ],
  "backups": {
    "schedule": "30 2 * * *",
    "retain": 7
  },
  "ui": {
    "launchPath": "/",
    "configurePath": "/configure"
  }
}
